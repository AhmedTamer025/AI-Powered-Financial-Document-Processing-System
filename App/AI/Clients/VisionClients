    /* Main entry point.
    EXTRACTION_MODE=ocr
          -> old Mistral OCR implementation
      EXTRACTION_MODE=vision
         -> Laravel AI SDK + ExtractionAgent
    */
    public function extract(string $path): array
    {
        $mode = config('ai.extraction.mode', 'ocr');

        return match ($mode) {
            'ocr' => $this->extractUsingOcr($path),

            'vision' => $this->extractUsingVision($path),

            default => throw new ExtractionException(
                "Invalid extraction mode: {$mode}. Expected: ocr or vision."
            ),
        };
    }

    /* OCR
     Original Mistral OCR path. POST /ocr only.
     Do not send this result through vision normalization. */

    private function extractUsingOcr(string $path): array
    {
        $this->validateFile($path);

        try {

            $response = Http::baseUrl(
                config('services.mistral.base_url')
            )
                ->withToken(
                    config('services.mistral.key')
                )
                ->acceptJson()
                ->timeout(
                    config('ai.extraction.timeout', 1800)
                )
                ->retry(
                    config('ai.extraction.retries', 3),
                    1000,
                    throw: false
                )
                ->post('/ocr', [

                    'model' => 'mistral-ocr-latest',

                    'document' => $this->createDocument($path),

                    'table_format' => 'markdown',

                    'include_image_base64' => false,

                    'include_blocks' => true,

                    'confidence_scores_granularity' => 'page',
                ]);

            if (!$response->successful()) {

                throw new ExtractionException(
                    'OCR API error: ' . $response->body()
                );
            }

            $payload = $response->json();
            $usageInfo = $this->normalizeUsageInfo($payload);

            if ($usageInfo !== []) {
                $payload['usage_info'] = array_merge(
                    is_array($payload['usage_info'] ?? null) ? $payload['usage_info'] : [],
                    $usageInfo,
                    [
                        'mode' => 'ocr',
                        'provider' => config('ai.extraction.provider', 'mistral'),
                    ]
                );
            }

            return $payload;
        } catch (\Throwable $e) {

            if ($e instanceof ExtractionException) {
                throw $e;
            }

            throw new ExtractionException(
                'OCR extraction failed: ' . $e->getMessage(),
                previous: $e
            );
        }
    }

