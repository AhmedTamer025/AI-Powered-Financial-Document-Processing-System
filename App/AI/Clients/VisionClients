    private function extractUsingVision(string $path): array
    {
        $this->validateFile($path);

        $mime = mime_content_type($path)
            ?: 'application/octet-stream';

        try {

        // Non-PDF
        //Keep images using the current synchronous path.
       

            if ($mime !== 'application/pdf') {

                $result =
                    $this->extractSingleVisionDocument(
                        $path
                    );

                if (!$this->hasExtractablePages($result)) {
                    return $this->handleEmptyVisionResult(
                        $path
                    );
                }

                $result['model'] = config(
                    'ai.extraction.vision_model',
                    config(
                        'ai.extraction.model',
                        'mistral-large-latest'
                    )
                );

                $result['usage_info'] = array_merge(
                    is_array(
                        $result['usage_info'] ?? null
                    )
                        ? $result['usage_info']
                        : [],
                    [
                        'mode' => 'vision',
                        'provider' => 'mistral',
                        'source' => 'extraction_agent',
                        'pages' =>
                        count($result['pages'] ?? []),
                    ]
                );

                return $result;
            }

        //pdf

            $pageCount =
                $this->detectPdfPageCount($path);

            $chunkSize = max(
                1,
                (int) config(
                    'ai.extraction.vision_chunk_pages',
                    8
                )
            );

        // Small PDF
       

            if ($pageCount <= $chunkSize) {

                $result =
                    $this->extractSingleVisionDocument(
                        $path
                    );

                if (!$this->hasExtractablePages($result)) {
                    return $this->handleEmptyVisionResult(
                        $path
                    );
                }

                $result['model'] = config(
                    'ai.extraction.vision_model',
                    config(
                        'ai.extraction.model',
                        'mistral-large-latest'
                    )
                );

                $result['usage_info'] = array_merge(
                    is_array(
                        $result['usage_info'] ?? null
                    )
                        ? $result['usage_info']
                        : [],
                    [
                        'mode' => 'vision',
                        'provider' => 'mistral',
                        'source' => 'extraction_agent',
                        'pages' =>
                        count($result['pages'] ?? []),
                    ]
                );

                return $result;
            }

        //Large PDF -> Parallel Batch
       

            return $this->extractPdfUsingVisionBatch(
                $path,
                $pageCount,
                $chunkSize
            );
        } catch (\Throwable $e) {

            return $this->handleVisionFailure(
                $path,
                $e
            );
        }
    }
    private function extractPdfUsingVisionBatch(
        string $path,
        int $pageCount,
        int $chunkSize
    ): array {

        $jobs = [];

        $chunkIndex = 1;

    // Build independent jobs
   

        for (
            $start = 1;
            $start <= $pageCount;
            $start += $chunkSize
        ) {

            $end =
                min(
                    $start + $chunkSize - 1,
                    $pageCount
                );

            $jobs[] =
                new ExtractVisionChunkJob(
                    path: $path,
                    startPage: $start,
                    endPage: $end,
                    chunkIndex: $chunkIndex
                );

            $chunkIndex++;
        }

    // Create batch first so we know its ID
   

        $batch = Bus::batch([])
            ->name(
                'Vision PDF Extraction - '
                    . basename($path)
            )
            ->allowFailures(false)
            ->dispatch();

        //Add jobs after we have batch ID
    

        foreach ($jobs as $job) {

            $job->batchId =
                $batch->id;
        }

        $batch->add($jobs);

        Log::info(
            'Vision parallel batch started',
            [
                'batch_id' => $batch->id,
                'file' => basename($path),
                'pages' => $pageCount,
                'chunk_size' => $chunkSize,
                'chunks' => count($jobs),
                'parallel_limit' =>
                config(
                    'ai.extraction.vision_parallel_jobs',
                    3
                ),
            ]
        );

      //Wait for all chunks
      //This method is being called from your existing extraction flow, so we wait here until all parallel jobs have completed.
    

        $timeoutSeconds = max(
            60,
            (int) config(
                'ai.extraction.vision_batch_wait_timeout',
                1800
            )
        );

        $startedAt = microtime(true);

        while (true) {

            $batch =
                Bus::findBatch(
                    $batch->id
                );

            if ($batch === null) {

                throw new \RuntimeException(
                    'Vision extraction batch could not be found.'
                );
            }

            if ($batch->finished()) {
                break;
            }

            if ($batch->cancelled()) {

                throw new \RuntimeException(
                    'Vision extraction batch was cancelled.'
                );
            }

            if (
                microtime(true) - $startedAt
                >= $timeoutSeconds
            ) {

                $batch->cancel();

                throw new \RuntimeException(
                    'Vision extraction batch timed out.'
                );
            }

            sleep(1);
        }

        //Assemble pages
    

        $allPages = [];
        $totalUsage = [];

        for (
            $index = 1;
            $index <= count($jobs);
            $index++
        ) {

            $resultPath =
                "vision-batches/{$batch->id}/chunk-{$index}.json";

            if (
                !Storage::disk('local')->exists(
                    $resultPath
                )
            ) {

                throw new \RuntimeException(
                    "Vision chunk result missing: {$index}"
                );
            }

            $json =
                Storage::disk('local')->get(
                    $resultPath
                );

            $result =
                json_decode(
                    $json,
                    true
                );

            if (
                !is_array($result)
            ) {

                throw new \RuntimeException(
                    "Invalid Vision chunk result: {$index}"
                );
            }

            foreach (
                $result['pages'] ?? []
                as $page
            ) {

                if (!is_array($page)) {
                    continue;
                }

                $pageIndex =
                    isset($page['index'])
                    && is_numeric($page['index'])
                    ? (int) $page['index']
                    : null;

                if ($pageIndex === null) {
                    continue;
                }

                $allPages[$pageIndex] =
                    $page;
            }

            $usage =
                $result['usage_info']
                ?? [];

            if (is_array($usage)) {

                $totalUsage =
                    $this->mergeUsageInfo(
                        $totalUsage,
                        $usage
                    );
            }
        }

    //Restore original page order
   

        ksort($allPages);

        $pages =
            array_values(
                $allPages
            );

        if ($pages === []) {

            return $this->handleEmptyVisionResult(
                $path
            );
        }

      //Cleanup temporary chunk files
   

        Storage::disk('local')->deleteDirectory(
            "vision-batches/{$batch->id}"
        );


        return [

            'pages' =>
            $pages,

            'model' =>
            config(
                'ai.extraction.vision_model',
                config(
                    'ai.extraction.model',
                    'mistral-large-latest'
                )
            ),

            'usage_info' => array_merge(
                $totalUsage,
                [
                    'mode' => 'vision',
                    'provider' => 'mistral',
                    'source' => 'extraction_agent',
                    'pages' => count($pages),
                    'chunk_size' => $chunkSize,
                    'parallel_chunks' =>
                    count($jobs),
                    'batch_id' =>
                    $batch->id,
                ]
            ),
        ];
    }
